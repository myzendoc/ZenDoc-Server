# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
MONGODB_URI=
JWT_SECRET=
CLIENT_APP_URL=

# ---------------------------------------------------------------------------
# PHI field encryption (required)
#
# Generate a key pair with:  node scripts/encryptPhi.js keygen
#
# Comma-separated keyId:base64Key entries. Keep retired keys listed until
# `node scripts/encryptPhi.js rotate` finishes re-encrypting under the new one,
# otherwise older records become unreadable.
#
# Losing every key listed here means losing every transcript, SOAP note, private
# note, and meeting title. Back them up somewhere separate from the database.
# ---------------------------------------------------------------------------
PHI_ENCRYPTION_KEYS=
PHI_ENCRYPTION_ACTIVE_KEY=

# ---------------------------------------------------------------------------
# Retention and audit integrity
#
# PHI_RETENTION_DAYS: how long soft-deleted clinical records stay recoverable
# before scripts/purgePhi.js disposes of them. Defaults to 2191 (6 years).
#
# AUDIT_CHAIN_SECRET: HMAC key for the audit log hash chain. Falls back to
# JWT_SECRET if unset. Changing it makes existing entries fail verification.
# ---------------------------------------------------------------------------
PHI_RETENTION_DAYS=
AUDIT_CHAIN_SECRET=

# ---------------------------------------------------------------------------
# Sessions
#
# Idle timeout is the automatic-logoff control (HIPAA 164.312(a)(2)(iii)).
# Absolute caps how long a stolen cookie is usable. "Remember this device"
# opts into the longer trusted lifetime and skips the MFA code on that device.
# The client's IDLE_TIMEOUT_MS in AuthContext.jsx must match the idle value.
# ---------------------------------------------------------------------------
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=24
SESSION_TRUSTED_TIMEOUT_HOURS=720
TRUSTED_DEVICE_DAYS=30

# Scheduled jobs run in-process from index.js. Default on unless NODE_ENV=development.
ENABLE_SCHEDULED_JOBS=
PHI_PURGE_INTERVAL_HOURS=
AUDIT_VERIFY_INTERVAL_HOURS=

# ---------------------------------------------------------------------------
# Admin accounts
#
# There is deliberately no ADMIN_EMAIL / ADMIN_PASSWORD / ADMIN_INVITE_CODE.
# Those granted access that no audit record could attribute to a real person.
# Create the first admin with database access instead:
#
#   node scripts/manageAdmin.js create --email you@example.com --first Ada
#
# After that, admins manage each other through the audited /api/admin routes.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Third-party processors
#
# Both of these receive patient data. A signed BAA is required with each before
# any real PHI flows through them.
#
# SOAP generation runs on Gemini Enterprise Agent Platform (formerly Vertex AI),
# which is HIPAA-eligible under the Google Cloud BAA. There is no code path to
# the AI Studio endpoint, which is not covered.
#
# Pick ONE auth method:
#   1. API key  -> set GOOGLE_CLOUD_API_KEY
#   2. ADC      -> set GOOGLE_CLOUD_PROJECT (recommended; automatic on Google
#                  Cloud, or `gcloud auth application-default login` locally,
#                  or GOOGLE_APPLICATION_CREDENTIALS for a service-account file)
# ---------------------------------------------------------------------------
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------------
# Billing
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_WEEKLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_PREMIUM_GROUP_MONTHLY=
STRIPE_PRICE_PREMIUM_GROUP_YEARLY=

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
